{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Devices": {
    "ToletusLiteNet2": {
      "ReconnectDelaySeconds": 5,
      "EnablePhysicalPassageConfirmation": false
    }
  },
  "OfflineStore": {
    "PermissionCacheMinutes": 30,
    "SyncBatchSize": 100
  },
  "ControlPlane": {
    "HeartbeatIntervalSeconds": 60
  }
}
