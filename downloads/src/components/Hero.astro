---
import { desktopRelease } from '../data/release';
const downloadEnabled = desktopRelease.status === 'available';
---
<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-content">
      <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span> AVELRI GESTÃO PARA WINDOWS</p>
      <h1 id="hero-title">Sua academia.<br />Sua operação.<br /><em>Em outro nível.</em></h1>
      <p class="hero-description">Organize alunos, planos, matrículas e financeiro em um só lugar com o Avelri Gestão Desktop.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#download">Ver disponibilidade <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#produto">Conhecer o produto <span aria-hidden="true">↓</span></a>
      </div>
      <p class="hero-note"><span class="status-dot" aria-hidden="true"></span> {downloadEnabled ? 'Download oficial disponível' : 'Download público aguardando autorização'}</p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="hero-art-orbit orbit-one"></div>
      <div class="hero-art-orbit orbit-two"></div>
      <div class="hero-art-core"><img src="/brand/avelri-icon-512.png" width="512" height="512" alt="" decoding="async" /></div>
      <div class="hero-art-light"></div>
      <span class="art-label art-label-top">GESTÃO</span>
      <span class="art-label art-label-bottom">CLAREZA PARA OPERAR</span>
    </div>
  </div>
  <div class="hero-bottom-line" aria-hidden="true"></div>
</section>
